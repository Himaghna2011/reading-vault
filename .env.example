# ============================================
# Reading Vault - Environment Variables
# ============================================
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file.
# ============================================

# ----- AI Provider API Keys -----
# Get your Groq key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get your Cohere key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Get your DeepSeek key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ----- Flask Configuration -----
# Generate a random secret string (any long random text)
SECRET_KEY=your_secret_key_here

# ----- Admin Account -----
# This account gets admin privileges on the site
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Your Name